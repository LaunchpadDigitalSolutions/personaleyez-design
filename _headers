# Job 23: HTML, JS and CSS are re-checked on every load (cheap 304 when
# unchanged), so a change reaches visitors on their next page view instead of
# up to 4 hours later. Images (/img/*) and fonts are deliberately NOT listed,
# so their caching is unchanged. Product/site photos come from Pages Functions
# (own Cache-Control), which this file never touches.
/
  Cache-Control: public, max-age=0, must-revalidate
/:page
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
